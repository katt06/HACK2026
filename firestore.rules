rules_version = '2';

// Deny-by-default. Collections are opened up explicitly as features land.
// transactions/ and recurring/ must stay server-only (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Members can read their groups. A client may only create a group whose sole
    // member is itself; joining goes through the joinGroup callable, so clients
    // never update members directly.
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validNewGroup(request.resource.data);
    }

    function validNewGroup(g) {
      return g.keys().hasOnly(['name', 'members', 'memberNames', 'inviteCode'])
        && g.name is string && g.name.size() > 0 && g.name.size() <= 40
        && g.members == [request.auth.uid]
        && g.memberNames.keys().hasOnly([request.auth.uid])
        && g.memberNames[request.auth.uid] is string
        && g.inviteCode.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$');
    }

    // Goals are private to their owner. Clients can edit the plan and log entries, but
    // verified and sizingRecommendation are server-only, and logged contributions are always unverified.
    match /goals/{goalId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && validNewGoal(request.resource.data);
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'targetAmount', 'deadline', 'pausedUntil', 'currentAmount'])
        && validGoalFields(request.resource.data);

      match /entries/{entryId} {
        allow read: if ownsGoal(goalId);
        allow create: if ownsGoal(goalId) && validNewEntry(request.resource.data);
      }
    }

    function ownsGoal(goalId) {
      return signedIn()
        && get(/databases/$(database)/documents/goals/$(goalId)).data.ownerId == request.auth.uid;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validGoalFields(g) {
      return g.name is string && g.name.size() > 0 && g.name.size() <= 60
        && g.targetAmount is int && g.targetAmount > 0
        && g.currentAmount is int && g.currentAmount >= 0
        && isDate(g.deadline)
        && (g.pausedUntil == null || isDate(g.pausedUntil));
    }

    function validNewGoal(g) {
      return g.keys().hasOnly(['ownerId', 'name', 'targetAmount', 'currentAmount', 'deadline', 'verified', 'sizingRecommendation', 'pausedUntil', 'createdAt'])
        && g.keys().hasAll(['ownerId', 'name', 'targetAmount', 'currentAmount', 'deadline', 'verified', 'sizingRecommendation', 'pausedUntil', 'createdAt'])
        && g.ownerId == request.auth.uid
        && g.currentAmount == 0
        && g.verified == false
        && g.sizingRecommendation == null
        && g.createdAt is string
        && validGoalFields(g);
    }

    function validNewEntry(e) {
      return e.amount is int && e.amount > 0
        && e.note is string && e.note.size() <= 80
        && e.createdAt is string
        && (
          (e.kind == 'contribution'
            && e.keys().hasOnly(['kind', 'amount', 'verified', 'note', 'createdAt'])
            && e.verified == false)
          || (e.kind == 'expense'
            && e.keys().hasOnly(['kind', 'amount', 'choice', 'weeksLater', 'note', 'createdAt'])
            && e.choice in ['pause', 'lowerPace']
            && e.weeksLater is int)
        );
    }

    // Your own score only, for now. Whether group members can read each other's
    // scores (and how) is still being decided; until then the leaderboard goes through a callable.
    match /scores/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
